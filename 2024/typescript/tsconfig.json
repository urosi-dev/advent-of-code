{
  "compilerOptions": {
    "strict": true,
    "outDir": "./dist",
    "target": "esnext",
    "rootDir": "./src/",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
